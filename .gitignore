__pycache__/
*.pyc
tmp/
.vscode/
*.egg-info/
dist/
build/
.pytest_cache/
*.db
*.db-shm
*.db-wal
# ...but device-db/ IS the vendored device (tile) database, and its per-tile
# files are named bits.db.  Without this exception `*.db` above silently
# excludes all 605 of them and `git status` shows nothing, which defeats the
# entire point of vendoring the tree.  These are text, not SQLite.
!device-db/**/*.db
docs/issues/
diamond-fuzz/results/
diamond-fuzz/targets/**/impl1/
# Local-only: project agent instructions (external RE project); keep out of the public repo
CLAUDE.md

# recovered-netlist deliverables (regenerable from the DB)
out/

# Vendor tool installers / downloaded sources (large, not part of the repo)
sources/

# Anlogic eagle_s20 fuse DB — DERIVED from proprietary Tang Dynasty; regenerable
# via scripts/anlogic_dbdecode.py (see boards/fnirsi-eg4s20/README.md).  Never commit.
boards/*/eagle_s20_db/
*.anloconfig

# Third-party ECP5 bitstreams (decoder interop corpus).  These are OTHER
# PEOPLE'S binaries, downloaded to test a decoder against real-world input.
# Downloading a publicly offered file to test interoperability is fine;
# redistributing it from this repo is not.  corpus/manifest.json IS committed
# and records URL + SHA-256 for every file, so the corpus is reproducible from
# the original sources without us mirroring anyone's build output.
# Rebuild with: python3.15t scripts/ecp5_corpus_fetch.py --candidates ...
corpus/ecp5/
# Our own Diamond builds — regenerable via scripts/ecp5_diamond_build.py.
corpus/diamond/
# Commercial-product firmware, and the bitstreams carved out of it by
# scripts/ecp5_carve.py.  Same rule as corpus/ecp5/, and it matters more here:
# these are vendor update files downloaded for decoder interoperability testing.
# Never redistributed; corpus/commercial-manifest.json records the provenance.
corpus/commercial/
corpus/vendor-firmware/
