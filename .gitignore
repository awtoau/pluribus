__pycache__/
*.pyc
tmp/
.vscode/
*.egg-info/
dist/
build/
.pytest_cache/
*.db
*.db-shm
*.db-wal
# ...but device-db/ IS the vendored device (tile) database, and its per-tile
# files are named bits.db.  Without this exception `*.db` above silently
# excludes all 605 of them and `git status` shows nothing, which defeats the
# entire point of vendoring the tree.  These are text, not SQLite.
!device-db/**/*.db
docs/issues/
diamond-fuzz/results/
diamond-fuzz/targets/**/impl1/
# Local-only: project agent instructions (external RE project); keep out of the public repo
CLAUDE.md

# recovered-netlist deliverables (regenerable from the DB)
out/

# Vendor tool installers / downloaded sources (large, not part of the repo).
# sources/README.md IS committed — manifest of what's there and how to re-fetch it,
# same pattern as corpus/manifest.json below.
sources/*
!sources/README.md

# Anlogic eagle_s20 fuse DB — DERIVED from proprietary Tang Dynasty; regenerable
# via scripts/anlogic_dbdecode.py (see boards/fnirsi-eg4s20/README.md).  Never commit.
boards/*/eagle_s20_db/
*.anloconfig

# Third-party ECP5 bitstreams (decoder interop corpus).  These are OTHER
# PEOPLE'S binaries, downloaded to test a decoder against real-world input.
# Downloading a publicly offered file to test interoperability is fine;
# redistributing it from this repo is not.  corpus/manifest.json IS committed
# and records URL + SHA-256 for every file, so the corpus is reproducible from
# the original sources without us mirroring anyone's build output.
# Rebuild with: python3.15t scripts/ecp5_corpus_fetch.py --candidates ...
corpus/ecp5/
# Our own Diamond builds — regenerable via scripts/ecp5_diamond_build.py.
corpus/diamond/
# Cyclone V post-fit oracle corpus: only src/ + design.toml are hand-written;
# everything else is regenerated by scripts/cyclonev_corpus_build.py.
corpus/cyclonev/*/*
!corpus/cyclonev/*/src/
!corpus/cyclonev/*/design.toml
# Cyclone V second-die corpus (5CEBA7, option-RAM die byte 0x13): same rule.
corpus/cyclonev_e150/*/*
!corpus/cyclonev_e150/*/src/
!corpus/cyclonev_e150/*/design.toml
corpus/cyclonev_e150/corpus.db
# Cyclone IV fuzz corpus: same rule; regenerated by scripts/cycloneiv_fuzz.py.
corpus/cycloneiv/*/*
!corpus/cycloneiv/*/src/
!corpus/cycloneiv/*/design.toml
# Commercial-product firmware, and the bitstreams carved out of it by
# scripts/ecp5_carve.py.  Same rule as corpus/ecp5/, and it matters more here:
# these are vendor update files downloaded for decoder interoperability testing.
# Never redistributed; corpus/commercial-manifest.json records the provenance.
corpus/commercial/
corpus/vendor-firmware/
# Diamond routing oracle per fuzz target (ncdread + ncd2nmc -r, parsed JSON) --
# regenerable via scripts/machxo2_diamond_oracle.py (#105).
corpus/machxo2/*
# Construct dictionary + coverage designs: only src/, design.toml, placement.lpf tracked;
# outputs regenerated by scripts/machxo2_construct_build.py.
!corpus/machxo2/constructs/
corpus/machxo2/constructs/*/*
!corpus/machxo2/constructs/*/src/
!corpus/machxo2/constructs/*/design.toml
!corpus/machxo2/constructs/*/placement.lpf
!corpus/machxo2/coverage/
corpus/machxo2/coverage/*/*
!corpus/machxo2/coverage/*/src/
!corpus/machxo2/coverage/*/design.toml
!corpus/machxo2/coverage/*/placement.lpf
# Global-network designs (multi-clock, secondary control nets): same layout.
!corpus/machxo2/globals/
corpus/machxo2/globals/*/*
!corpus/machxo2/globals/*/src/
!corpus/machxo2/globals/*/design.toml
!corpus/machxo2/globals/*/placement.lpf

# Generated by scripts/efb_boot_gen.py from a board spi_registers.tsv --
# regenerable, board-specific, not source.
scripts/efb_wb_boot.vh

# Rust build artifacts (rust/*/target/) -- Cargo.lock IS committed for
# reproducible builds; the compiled output is not.
rust/*/target/

corpus/machxo2/constructs/_*.json
!corpus/machxo2/constructs/_skipped.json
corpus/machxo2/coverage/_*.json
corpus/machxo2/globals/_*.json
